{
  "starters": ["cavaleiro", "ninja", "robo", "mago_fogo", "mago_gelo", "mago_terra", "mago_vento"],
  "story": [
    "Há muito tempo... a cidade vivia em paz.",
    "Até que UM VILÃO invadiu tudo.",
    "Espalhou o caos.\nTrouxe a morte e a destruição.",
    "Numa zona escondida da cidade,\nconstruiu a sua base secreta.",
    "Os habitantes esconderam-se com medo.\nNinguém ajuda o herói.\nSó outros vilões apoiam o vilão.",
    "Mas um único herói se levanta\ncontra a escuridão...",
    "MIDORIYA.\nVeste a armadura.\nDefende a cidade."
  ],
  "lines": {
    "DRAGÃO": "RUUUAAARRR! VAIS ARDER!",
    "DEMÓNIO DE FOGO": "AS CHAMAS VÃO CONSUMIR-TE!",
    "COMISSÁRIO CORRUPTO": "ESTÁS PRESO! PARA SEMPRE!",
    "DOUTOR MUTANTE": "VOU OPERAR-TE... SEM ANESTESIA!",
    "SHIGARAKI": "VAIS DESINTEGRAR-TE COMIGO!",
    "GLITCH BOSS": "ERRO 404: HERÓI NÃO ENCONTRADO!",
    "CHEF MUTANTE": "BEM-VINDO AO MENU DE HOJE: TU!",
    "PALHAÇO DO MAL": "VAMOS DIVERTIR-NOS... ATÉ MORRERES!",
    "PROFESSOR FANTASMA": "REPROVADO. PERMANENTEMENTE.",
    "ALL FOR ONE": "EU SOU O VERDADEIRO MAL. PREPARA-TE.",
    "PALHAÇO SOMBRIO": "O CIRCO COMEÇA... E TU ÉS O ESPECTÁCULO!",
    "HOOLIGAN GIGANTE": "GOLO! NA TUA CARA, HERÓI!",
    "PILOTO RENEGADO": "PREPARA-TE PARA A DESCOLAGEM... PARA O OUTRO LADO!",
    "LOBO DAS SOMBRAS": "A FLORESTA ENGOLE-TE INTEIRO!",
    "DRAGÃO FINAL": "EU SOU O FIM DE TUDO. NEM AS NUVENS TE SALVAM!",
    "TUBARÃO TITÂNICO": "A PRAIA É MEU DOMÍNIO — E TU SERÁS O MEU ALMOÇO!",
    "ESCULTOR DO CAOS": "VOU ESCULPIR A TUA DERROTA EM MÁRMORE ETERNO!",
    "DR. NEUROTOXINA": "A CIÊNCIA NUNCA FALHA. E TU VAS PROVAR ISSO!",
    "MAESTRO DO MAL": "ESTA NOITE, A SINFONIA DA TUA DESTRUIÇÃO COMEÇA!",
    "ESPÍRITO SUPREMO": "EU EXISTO HÁ SÉCULOS. TU... NEM UM SEGUNDO MAIS!"
  },
